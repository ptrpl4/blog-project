# Hugo files
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Temporary lock file while building
/.hugo_build.lock

# Unpublished drafts — kept local, never committed
content/*/posts/drafts/

# Obsidian — vault root is content/; per-machine UI state only, app.json is tracked
content/.obsidian/workspace.json
content/.obsidian/appearance.json
content/.obsidian/core-plugins.json

# Other
.DS_Store
.vscode
.claude/
